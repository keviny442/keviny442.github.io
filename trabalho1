<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PS5 Games Store</title>
    <!-- CSS do Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Ícones do Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">

    <!-- Passo 3: Faixa de Aviso -->
    <div class="bg-primary text-white text-center py-2 fw-bold">
        Frete grátis para todo o Brasil em compras acima de R$ 199!
    </div>

    <!-- Passo 4: Navbar (Menu de Navegação) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" href="#">
                <i class="bi bi-controller me-2"></i>PS5 STORE
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNavegacao">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuNavegacao">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Início</a>
                    </li>
                    <!-- Dropdown Categorias -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                            Categorias
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Ação & Aventura</a></li>
                            <li><a class="dropdown-item" href="#">RPG</a></li>
                            <li><a class="dropdown-item" href="#">Esportes</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#">Lançamentos</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Ofertas</a>
                    </li>
                </ul>
                <!-- Busca e Carrinho -->
                <form class="d-flex me-3" role="search">
                    <input class="form-control me-2" type="search" placeholder="Buscar jogos de PS5...">
                    <button class="btn btn-outline-primary" type="submit">Buscar</button>
                </form>
                <div class="d-flex align-items-center mt-2 mt-lg-0">
                    <button class="btn btn-primary position-relative">
                        <i class="bi bi-cart3"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            3
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Passo 5: Container do Miolo da Página -->
    <div class="container my-4">

        <!-- Carrossel de Banners (3 slides) -->
        <div id="carrosselBanners" class="carousel slide mb-5" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#carrosselBanners" data-bs-slide-to="0" class="active"></button>
                <button type="button" data-bs-target="#carrosselBanners" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#carrosselBanners" data-bs-slide-to="2"></button>
            </div>
            <div class="carousel-inner rounded-3 shadow">
                <div class="carousel-item active">
                    <img src="https://placehold.co/1200x400/003791/ffffff?text=Demon%27s+Souls+PS5" class="d-block w-100" alt="Demon's Souls">
                </div>
                <div class="carousel-item">
                    <img src="https://placehold.co/1200x400/111111/ffffff?text=Spider-Man+2+PS5" class="d-block w-100" alt="Spider-Man 2">
                </div>
                <div class="carousel-item">
                    <img src="https://placehold.co/1200x400/051923/ffffff?text=God+of+War+Ragnarok" class="d-block w-100" alt="God of War">
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carrosselBanners" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carrosselBanners" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>

        <!-- Passo 6: Seção Categorias (6 no desktop / 3 no celular) -->
        <h2 class="mb-3 border-bottom pb-2">Categorias</h2>
        <div class="row g-3 mb-5">
            <div class="col-lg-2 col-4">
                <div class="card text-center p-3 h-100 shadow-sm border-0">
                    <i class="bi bi-shield-shaded display-6 text-primary mb-2"></i>
                    <h6 class="card-title m-0">Ação</h6>
                </div>
            </div>
            <div class="col-lg-2 col-4">
                <div class="card text-center p-3 h-100 shadow-sm border-0">
                    <i class="bi bi-dragon display-6 text-primary mb-2"></i>
                    <h6 class="card-title m-0">RPG</h6>
                </div>
            </div>
            <div class="col-lg-2 col-4">
                <div class="card text-center p-3 h-100 shadow-sm border-0">
                    <i class="bi bi-dribbble display-6 text-primary mb-2"></i>
                    <h6 class="card-title m-0">Esportes</h6>
                </div>
            </div>
            <div class="col-lg-2 col-4">
                <div class="card text-center p-3 h-100 shadow-sm border-0">
                    <i class="bi bi-crosshair display-6 text-primary mb-2"></i>
                    <h6 class="card-title m-0">FPS</h6>
                </div>
            </div>
            <div class="col-lg-2 col-4">
                <div class="card text-center p-3 h-100 shadow-sm border-0">
                    <i class="bi bi-flag-fill display-6 text-primary mb-2"></i>
                    <h6 class="card-title m-0">Corrida</h6>
                </div>
            </div>
            <div class="col-lg-2 col-4">
                <div class="card text-center p-3 h-100 shadow-sm border-0">
                    <i class="bi bi-controller display-6 text-primary mb-2"></i>
                    <h6 class="card-title m-0">Luta</h6>
                </div>
            </div>
        </div>

        <!-- Passo 7: Seção Destaques (4 no desktop / 2 no tablet / 1 no celular) -->
        <h2 class="mb-3 border-bottom pb-2">Destaques PS5</h2>
        <div class="row g-4 mb-5">
            <!-- Card 1 -->
            <div class="col-lg-3 col-md-6 col-12">
                <div class="card h-100 shadow-sm border-0 position-relative">
                    <span class="badge text-bg-danger position-absolute top-0 start-0 m-2">Promoção</span>
                    <img src="https://placehold.co/400x400/003791/ffffff?text=Spider-Man+2" class="card-img-top" alt="Marvel's Spider-Man 2">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Marvel's Spider-Man 2</h5>
                        <p class="card-text text-muted small">Exclusivo PlayStation 5</p>
                        <div class="mt-auto">
                            <p class="card-text mb-2">
                                <span class="text-muted text-decoration-line-through small me-2">R$ 349,90</span>
                                <strong class="text-danger fs-5">R$ 299,00</strong>
                            </p>
                            <button class="btn btn-outline-primary mb-2 w-100" data-bs-toggle="modal" data-bs-target="#modalJogo1">
                                Ver Detalhes
                            </button>
                            <button class="btn btn-primary w-100">Adicionar ao carrinho</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="col-lg-3 col-md-6 col-12">
                <div class="card h-100 shadow-sm border-0 position-relative">
                    <span class="badge text-bg-danger position-absolute top-0 start-0 m-2">Promoção</span>
                    <img src="https://placehold.co/400x400/111111/ffffff?text=God+of+War" class="card-img-top" alt="God of War Ragnarök">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">God of War Ragnarök</h5>
                        <p class="card-text text-muted small">Aventura Épica de Kratos</p>
                        <div class="mt-auto">
                            <p class="card-text mb-2">
                                <span class="text-muted text-decoration-line-through small me-2">R$ 349,90</span>
                                <strong class="text-danger fs-5">R$ 249,00</strong>
                            </p>
                            <button class="btn btn-outline-primary mb-2 w-100" data-bs-toggle="modal" data-bs-target="#modalJogo1">
                                Ver Detalhes
                            </button>
                            <button class="btn btn-primary w-100">Adicionar ao carrinho</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="col-lg-3 col-md-6 col-12">
                <div class="card h-100 shadow-sm border-0 position-relative">
                    <span class="badge text-bg-success position-absolute top-0 start-0 m-2">Novo</span>
                    <img src="https://placehold.co/400x400/051923/ffffff?text=Elden+Ring" class="card-img-top" alt="Elden Ring">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Elden Ring PS5</h5>
                        <p class="card-text text-muted small">RPG do Ano com HDR10</p>
                        <div class="mt-auto">
                            <p class="card-text mb-2">
                                <span class="text-muted text-decoration-line-through small me-2">R$ 299,90</span>
                                <strong class="text-danger fs-5">R$ 219,00</strong>
                            </p>
                            <button class="btn btn-outline-primary mb-2 w-100" data-bs-toggle="modal" data-bs-target="#modalJogo1">
                                Ver Detalhes
                            </button>
                            <button class="btn btn-primary w-100">Adicionar ao carrinho</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="col-lg-3 col-md-6 col-12">
                <div class="card h-100 shadow-sm border-0 position-relative">
                    <span class="badge text-bg-danger position-absolute top-0 start-0 m-2">Promoção</span>
                    <img src="https://placehold.co/400x400/222222/ffffff?text=Demon%27s+Souls" class="card-img-top" alt="Demon's Souls">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Demon's Souls</h5>
                        <p class="card-text text-muted small">Remake Total PS5</p>
                        <div class="mt-auto">
                            <p class="card-text mb-2">
                                <span class="text-muted text-decoration-line-through small me-2">R$ 349,90</span>
                                <strong class="text-danger fs-5">R$ 179,00</strong>
                            </p>
                            <button class="btn btn-outline-primary mb-2 w-100" data-bs-toggle="modal" data-bs-target="#modalJogo1">
                                Ver Detalhes
                            </button>
                            <button class="btn btn-primary w-100">Adicionar ao carrinho</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Banners Promocionais -->
        <div class="row g-3 mb-5">
            <div class="col-md-6">
                <div class="p-4 bg-primary text-white rounded-3 shadow-sm">
                    <h3>Controles DualSense</h3>
                    <p>Garanta uma experiência imersiva com resposta tátil e gatilhos adaptativos.</p>
                    <button class="btn btn-light text-primary fw-bold">Confira as Cores</button>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-4 bg-dark text-white rounded-3 shadow-sm">
                    <h3>Headset Sem Fio Pulse 3D</h3>
                    <p>Áudio em 3D ajustado para consoles PlayStation 5.</p>
                    <button class="btn btn-primary fw-bold">Comprar Agora</button>
                </div>
            </div>
        </div>

        <!-- Benefícios -->
        <div class="row text-center py-4 bg-white rounded-3 shadow-sm mb-5 g-3">
            <div class="col-md-4">
                <i class="bi bi-truck display-5 text-primary"></i>
                <h5 class="mt-2">Entrega para todo o Brasil</h5>
                <p class="text-muted small mb-0">Envio rápido e rastreado</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-shield-check display-5 text-primary"></i>
                <h5 class="mt-2">Pagamento Seguro</h5>
                <p class="text-muted small mb-0">Pix, boleto ou cartão em até 12x</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-arrow-counterclockwise display-5 text-primary"></i>
                <h5 class="mt-2">Troca grátis em 30 dias</h5>
                <p class="text-muted small mb-0">Garantia direto com a loja</p>
            </div>
        </div>

        <!-- Newsletter (Input-Group) -->
        <div class="card p-4 bg-dark text-white shadow-sm mb-5">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-3 mb-lg-0">
                    <h4 class="m-0">Receba nossas ofertas exclusivas do PS5</h4>
                    <p class="text-muted small m-0">Cadastre seu e-mail para não perder promoções e lançamentos.</p>
                </div>
                <div class="col-lg-6">
                    <div class="input-group">
                        <input type="email" class="form-control" placeholder="Digite seu e-mail...">
                        <button class="btn btn-primary" type="button">Assinar</button>
                    </div>
                </div>
            </div>
        </div>

    </div> <!-- Fim do Container -->

    <!-- Modal de Detalhes do Produto -->
    <div class="modal fade" id="modalJogo1" tabindex="-1" aria-labelledby="modalJogo1Label" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalJogo1Label">Detalhes do Jogo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="https://placehold.co/400x300/003791/ffffff?text=Detalhes+do+Jogo" class="img-fluid rounded mb-3" alt="Jogo PS5">
                    <h5>Informações Técnicas</h5>
                    <p class="text-muted">Aproveite tempos de carregamento ultrarrápidos, suporte para resposta tátil e gatilhos adaptativos no controle DualSense, além do incrível visual em até 4K 60FPS.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" class="btn btn-primary">Comprar Agora</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Rodapé (Footer) -->
    <footer class="bg-dark text-white pt-5 pb-3">
        <div class="container">
            <div class="row g-4 border-bottom pb-4 mb-3">
                <div class="col-md-3">
                    <h5 class="text-primary mb-3">Institucional</h5>
                    <ul class="list-unstyled text-muted small">
                        <li><a href="#" class="text-decoration-none text-white-50">Sobre a Loja</a></li>
                        <li><a href="#" class="text-decoration-none text-white-50">Políticas de Privacidade</a></li>
                        <li><a href="#" class="text-decoration-none text-white-50">Termos e Condições</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5 class="text-primary mb-3">Ajuda</h5>
                    <ul class="list-unstyled text-muted small">
                        <li><a href="#" class="text-decoration-none text-white-50">Atendimento ao Cliente</a></li>
                        <li><a href="#" class="text-decoration-none text-white-50">Prazos de Entrega</a></li>
                        <li><a href="#" class="text-decoration-none text-white-50">Trocas e Devoluções</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5 class="text-primary mb-3">Redes Sociais</h5>
                    <div class="d-flex gap-3 fs-5">
                        <a href="#" class="text-white-50"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white-50"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-white-50"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="text-white-50"><i class="bi bi-twitch"></i></a>
                    </div>
                </div>
                <div class="col-md-3">
                    <h5 class="text-primary mb-3">Formas de Pagamento</h5>
                    <div class="d-flex gap-2 fs-4 text-white-50">
                        <i class="bi bi-credit-card-2-front"></i>
                        <i class="bi bi-qr-code"></i>
                        <i class="bi bi-bank"></i>
                    </div>
                </div>
            </div>
            <div class="text-center text-white-50 small">
                © 2026 PS5 Store. Todos os direitos reservados.
            </div>
        </div>
    </footer>

    <!-- JS do Bootstrap (no fim do body) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
